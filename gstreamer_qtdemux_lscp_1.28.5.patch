+static GstCaps *
+qtdemux_illumination_caps (GstQTDemux * qtdemux, QtDemuxStream * stream,
+    QtDemuxStreamStsdEntry * entry, guint32 fourcc,
+    GNode * stsd_entry, gchar ** codec_name)
+{
+  GstCaps *caps;
+
+  switch (fourcc) {
+    case FOURCC_lscp:
+    {
+        const guint8 *stsd_entry_data = stsd_entry->data;
+        gsize size = QT_UINT32 (stsd_entry_data);
+        GstByteReader reader = GST_BYTE_READER_INIT (stsd_entry_data, size);
+
+        guint8 *lscc_buf = NULL;
+        guint8 *colr_buf = NULL;
+        guint8 *btrt_buf = NULL;
+
+        guint32 lscp_box_size;
+        guint32 lscc_box_size;
+        guint32 colr_box_size;
+        guint32 btrt_box_size;
+
+        /* skip lscp box */
+        if (!(gst_byte_reader_peek_uint32_be(&reader, &lscp_box_size)) || !(gst_byte_reader_skip (&reader,  8 + 1 + 3 + 4))) {
+          GST_WARNING_OBJECT (qtdemux, "Too short lscp sample entry");
+          break;
+        }
+        /* read lscc box */
+        if (!(gst_byte_reader_peek_uint32_be(&reader, &lscc_box_size)) || !(gst_byte_reader_dup_data(&reader, lscc_box_size, &lscc_buf))) {
+          GST_WARNING_OBJECT (qtdemux, "Unable to duplicate lscc data");
+          break;
+        }
+        /* Parse profilesLevelsIndication from lscc FullBox (present when flags & 0x01).
+         * lscc_buf layout: [0-3] size, [4-7] fourcc, [8] version, [9-11] flags, [12] pli.
+         * Defaults: profile=0 (Base Profile), level=1 (Level 1). */
+        guint8 lscp_profile = 0;
+        guint8 lscp_level = 1;
+        if (lscc_box_size >= 13 && (lscc_buf[11] & 0x01)) {
+          guint8 pli = lscc_buf[12];
+          lscp_profile = pli >> 4;
+          lscp_level = pli & 0x0F;
+        }
+        /* read colr box */
+        if (!(gst_byte_reader_peek_uint32_be(&reader, &colr_box_size)) || !(gst_byte_reader_dup_data(&reader, colr_box_size, &colr_buf))) {
+          GST_WARNING_OBJECT (qtdemux, "Unable to duplicate colr data");
+          break;
+        }
+        /* read btrt box */
+        if (!(gst_byte_reader_peek_uint32_be(&reader, &btrt_box_size)) || !(gst_byte_reader_dup_data(&reader, btrt_box_size, &btrt_buf))) {
+          GST_WARNING_OBJECT (qtdemux, "Unable to duplicate btrt data");
+          break;
+        }
+
+        GstBuffer *lscc_box = gst_buffer_new_wrapped(lscc_buf, lscc_box_size);
+        GstBuffer *colr_box = gst_buffer_new_wrapped(colr_buf, colr_box_size);
+        GstBuffer *btrt_box = gst_buffer_new_wrapped(btrt_buf, btrt_box_size);
+
+        caps =
+            gst_caps_new_simple ("application/octet-stream",
+                                 "lscc-box", GST_TYPE_BUFFER, lscc_box,
+                                 "colr-box", GST_TYPE_BUFFER, colr_box,
+                                 "btrt-box", GST_TYPE_BUFFER, btrt_box,
+                                 "lscp-profile", G_TYPE_INT, (gint) lscp_profile,
+                                 "lscp-level", G_TYPE_INT, (gint) lscp_level,
+                                 NULL);
+        gst_buffer_unref (lscc_box);
+        gst_buffer_unref (colr_box);
+        gst_buffer_unref (btrt_box);
+
+        _codec ("Timed Binary Metadata");
+        break;
+      }
+    default:
+      caps = NULL;
+      break;
+  }
+  return caps;
+}
+
+
 static GstCaps *
 qtdemux_generic_caps (GstQTDemux * qtdemux, QtDemuxStream * stream,
     QtDemuxStreamStsdEntry * entry, guint32 fourcc,
